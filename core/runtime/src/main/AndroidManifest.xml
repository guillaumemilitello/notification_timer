<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name=".service.TimerForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Notification timer background countdown and alert playback" />
        </service>

        <receiver
            android:name=".receiver.TimerActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".receiver.WakeupReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.notification.timer.action.WAKEUP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
