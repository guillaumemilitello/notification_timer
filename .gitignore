# Android/Gradle project ignore rules

# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
**/build/

# Gradle wrapper
!gradle/wrapper/gradle-wrapper.jar
/gradle/wrapper/gradle-wrapper.jar

# Local configuration files
local.properties

# Signing files
*.jks
*.keystore

# Android Studio
.idea/
*.iml

# Keystore files
*.keystore
*.jks

# NDK
.cxx/
.externalNativeBuild/

# Logs
*.log

# Captures
captures/

# Misc
.DS_Store
*.orig
